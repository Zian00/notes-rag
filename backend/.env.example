# Copy to backend/.env and fill in. NEVER commit the real .env.
# Host port 5433 maps to the container's 5432 (see docker-compose.yml) to avoid
# clashing with a Postgres already running on the host's 5432.
DATABASE_URL=postgresql+asyncpg://notes:notes@localhost:5433/notes_rag
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-2.5-flash
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
